# Event Wall Socket.io Configuration
# Copiar este archivo a .env y ajustar según tu ambiente

# Puerto del servidor
PORT=3000

# Ambiente
NODE_ENV=development

# URL CORS (origen permitido del frontend)
CORS_ORIGIN=http://localhost:5173

# API Key para acciones administrativas
ADMIN_API_KEY=your-secret-admin-key-here

# Base de datos (opcional, para persistencia)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visora_events
DB_USER=postgres
DB_PASSWORD=

# Logging
LOG_LEVEL=info
